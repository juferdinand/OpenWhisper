{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM"],
    "moduleResolution": "Bundler", "resolveJsonModule": true, "strict": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "skipLibCheck": true,
    "noEmit": true, "isolatedModules": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "paths": { "zod": ["./node_modules/zod"] }
  },
  "include": ["src"]
}
