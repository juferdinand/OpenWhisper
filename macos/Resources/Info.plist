<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>OpenWhisper</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.whisperfree</string>
	<key>CFBundleName</key>
	<string>OpenWhisper</string>
	<key>CFBundleDisplayName</key>
	<string>OpenWhisper</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Native model requests allow only these two numeric loopback addresses. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>::1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- GitHub repository for updates ("owner/repo"); "OWNER/…" disables the updater. -->
	<key>WFUpdateRepository</key>
	<string>OWNER/OpenWhisper</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>OpenWhisper needs microphone access to record your voice. Speech recognition runs on your Mac.</string>
</dict>
</plist>
