{
  "name": "openwhisper-electron",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "preflight": "tsx scripts/preflight.ts",
    "set-version": "tsx scripts/set-version.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/owned-retirement/*.test.ts tests/owned-bus-async/*.test.ts tests/owned-supervisor-fallback/*.test.ts",
    "test:platform": "tsx --test tests/*platform*.test.ts tests/portal-*.test.ts tests/clipboard-output.test.ts tests/wayland-clipboard.test.ts tests/delivery-receipts.test.ts tests/preferences.test.ts",
    "build": "tsx scripts/build.ts",
    "build:native": "tsx scripts/build-native.ts",
    "dev": "tsx scripts/dev.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "koffi": "3.3.2",
    "tar": "7.5.22",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/universal": "3.0.6",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.19.1",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
