{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 6-9 * * 1"
  ],
  "automerge": false,
  "prConcurrentLimit": 5,
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "npm"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^app/native/whisper-source\\.json$/"
      ],
      "matchStrings": [
        "\"tag\":\\s*\"(?<currentValue>b[0-9]+)\""
      ],
      "depNameTemplate": "ggml-org/whisper.cpp",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^b(?<major>[0-9]+)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchPackageNames": [
        "ggml-org/whisper.cpp"
      ],
      "dependencyDashboardApproval": true,
      "prBodyNotes": [
        "Review upstream release notes and Whisper/Parakeet API changes. Update the tag, pinned commit, and source archive SHA256 in app/native/whisper-source.json; keep checksum verification enabled and run the native speech and package checks on macOS and Linux."
      ]
    },
    {
      "description": "Keep the Ubuntu 22.04 packaging baseline and macOS 15 universal-build environment until a separate runner migration is validated.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "22.04"
    },
    {
      "description": "Keep the existing macOS universal-build environment until a separate runner migration is validated.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "macos"
      ],
      "allowedVersions": "15"
    }
  ],
  "dependencyDashboardAutoclose": true
}
