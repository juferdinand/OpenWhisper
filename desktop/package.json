{
  "name": "whisperfree-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "bundle:linux": "tauri build --config src-tauri/bundle.conf.json --bundles deb,appimage && python3 scripts/name-packages.py",
    "test:ui": "playwright test",
    "format:check": "prettier --check src vite.config.ts playwright.config.ts tests"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
